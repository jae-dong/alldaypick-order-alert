
# 텔레그램 주문알림(선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 알림은 텔레그램 전용으로 사용합니다.
# Bot Token과 Chat ID는 GitHub에 올리지 마세요.

# 텔레그램 전송기록 방식 활성화
TELEGRAM_LEDGER=1

# 아래 진단 기능은 평소에는 0으로 유지하세요.
# 기존 데이터 일회성 정리가 꼭 필요할 때만 1로 바꿉니다.
RUN_LEGACY_MIGRATION=0
# 전체 주문문서 진단 조회는 무료 읽기 한도를 사용하므로 평소에는 0입니다.
ENABLE_DIAGNOSTICS=0

# 무료 한도 권장 주기: 신규/발송대기 10분, 전체상태 30분
FAST_POLL_MINUTES=10
POLL_INTERVAL_MINUTES=30
FULL_SYNC_EVERY=4

# 무료 한도 모드에서는 아래 값을 0으로 유지하세요.

# 스마트스토어 문의 API는 주문 API와 분리해 60분 간격으로만 조회합니다.
# 429 제한이 발생하면 기본 120분 동안 캐시를 사용합니다.
SMARTSTORE_INQUIRY_INTERVAL_MINUTES=60
SMARTSTORE_INQUIRY_429_COOLDOWN_MINUTES=120

# v7.7.18 쿠팡 전체상태 보정 범위
# 시작 시 최근 14일의 신규/발송대기/배송중/배송완료를 백그라운드에서 다시 확인합니다.
STARTUP_DEEP_LOOKBACK_DAYS=14
STARTUP_DEEP_MAX_PAGES=8
# 웹앱에서 지금 수집을 누른 경우 더 넓은 범위를 확인합니다.
MANUAL_DEEP_LOOKBACK_DAYS=31
MANUAL_DEEP_MAX_PAGES=10


# ============================================================
# v7.7.34 사업자 프로필
# ============================================================
# 기본값 ALLDAYPICK: 기존 v7.7.33의 unprefixed API 키를 그대로 사용합니다.
# 데일리픽 API 키 등록을 마친 뒤 DAILYPICK으로 바꾸면 새 사업자만 수집합니다.
ORDER_ALERT_BUSINESS_PROFILE=ALLDAYPICK

# 올데이픽은 기존 환경변수를 자동 호환합니다.
# 원하면 아래 ALLDAYPICK_ 접두사 키로 옮겨도 됩니다.
ALLDAYPICK_COUPANG_ENABLED=1
ALLDAYPICK_SMARTSTORE_ENABLED=1
ALLDAYPICK_ELEVENST_ENABLED=1
ALLDAYPICK_LOTTEON_ENABLED=1
# ALLDAYPICK_COUPANG_ACCESS_KEY=
# ALLDAYPICK_COUPANG_SECRET_KEY=
# ALLDAYPICK_COUPANG_VENDOR_ID=
# ALLDAYPICK_NAVER_CLIENT_ID=
# ALLDAYPICK_NAVER_CLIENT_SECRET=
# ALLDAYPICK_ELEVENST_API_KEY=
# ALLDAYPICK_ELEVENST_SELLER_ID=
# ALLDAYPICK_LOTTEON_API_KEY=
# ALLDAYPICK_LOTTEON_SELLER_ID=
# ALLDAYPICK_LOTTEON_LOGIN_ID=

# 데일리픽: 현재 스마트스토어 / 11번가 / 롯데온 사용
DAILYPICK_COUPANG_ENABLED=0
DAILYPICK_SMARTSTORE_ENABLED=1
DAILYPICK_ELEVENST_ENABLED=1
DAILYPICK_LOTTEON_ENABLED=1
DAILYPICK_NAVER_CLIENT_ID=
DAILYPICK_NAVER_CLIENT_SECRET=
DAILYPICK_ELEVENST_API_KEY=
DAILYPICK_ELEVENST_SELLER_ID=
DAILYPICK_LOTTEON_API_KEY=
DAILYPICK_LOTTEON_SELLER_ID=
DAILYPICK_LOTTEON_LOGIN_ID=

# G마켓/옥션은 현재 주문 API가 없어 v7.7.34에서도 미연동으로 유지합니다.
